model Booking {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // এক বুকিংয়ে একাধিক সিট থাকতে পারে
  seats Seat[]

  // স্ট্যাটাস ও অ্যামাউন্ট
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  totalAmount   String // সার্ভিস কোডের সাথে মিল রাখার জন্য String রাখা হলো

  // পেমেন্ট গেটওয়ে লিংক (ইউজার রিডাইরেক্টের জন্য)
  paymentUrl String?

  // 🎯 One-to-One Relation with Payment Table
  payment Payment?

  // সিট লক করে রাখার ডেডলাইন
  expiresAt DateTime

  // PDF এবং QR Code জেনারেট করার জন্য সিকিউর টোকেন
  ticketToken String? @unique @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([eventId])
  @@map("bookings")
}

enum Role {
  USER
  ADMIN
  ORGANIZER
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  BOOKED
  SOLD
}

// ১. বুকিং স্ট্যাটাস এনাম
enum BookingStatus {
  PENDING // কাস্টমার সিট সিলেক্ট করেছে কিন্তু এখনো পেমেন্ট করেনি
  CONFIRMED // পেমেন্ট সাকসেসফুল এবং টিকিট কনফার্মড
  CANCELLED // পেমেন্ট করতে দেরি করায় বা কাস্টমার নিজে ক্যান্সেল করলে
  REFUNDED // ইভেন্ট বাতিল বা রিফান্ড পলিসি অনুযায়ী টাকা ফেরত দিলে
}

// ২. পেমেন্ট স্ট্যাটাস এনাম
enum PaymentStatus {
  PENDING
  UNPAID
  PAID
  FAILED
}

enum PaymentMethod {
  OFFLINE
  STRIPE
  ONLINE
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  dateTime    DateTime
  venue       String
  price       Decimal  @db.Decimal(10, 2) // নিখুঁত হিসাবের জন্য Decimal ব্যবহার করা হয়েছে
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  seats    Seat[]
  bookings Booking[]

  @@map("events")
}

model Payment {
  id        String  @id @default(uuid())
  bookingId String  @unique // এক বুকিংয়ের একটাই পেমেন্ট রেকর্ড থাকবে
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // পেমেন্ট গেটওয়ে ভেরিфикации ফিল্ডস
  transactionId String        @unique // আমারপে-র mer_txnid বা স্ট্রাইপের payment_intent ID
  paymentMethod PaymentMethod @default(OFFLINE)
  status        PaymentStatus @default(PENDING)
  amount        Float // আসল ট্রানজেকশন অ্যামাউন্ট ট্র্যাকিংয়ের জন্য
  currency      String        @default("BDT")

  // গেটওয়ে থেকে আসা পুরো রেসপন্স অবজেক্ট (Metadata) সেভ রাখার জন্য
  paymentDetails Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Seat {
  id      String     @id @default(uuid())
  eventId String
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  row     String // e.g., 'A', 'B'
  number  Int // e.g., 1, 2, 3
  status  SeatStatus @default(AVAILABLE)

  // ৫ মিনিটের Redis Lock এবং রিয়েল-টাইম ট্র্যাকিং ফিল্ডস
  lockedAt       DateTime?
  lockedByUserId String?
  lockedByUser   User?     @relation(fields: [lockedByUserId], references: [id])

  // Race Condition এড়ানোর জন্য Optimistic Locking (DB Level)
  version Int @default(0)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // একই ইভেন্টে একই সিট যেন ডুপ্লিকেট না হয়
  @@unique([eventId, row, number])
  // দ্রুত লাইভ স্ট্যাটাস চেক করার জন্য ইনডেক্স
  @@index([eventId, status])
  @@map("seats")
}

// ইউজার অ্যাকাউন্ট কন্ট্রোল করার জন্য স্ট্যাটাস এনাম
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String
  role       Role       @default(USER) // USER, ADMIN, ORGANIZER
  status     UserStatus @default(ACTIVE)
  profilePic String?

  // অ্যাডমিন বা অর্গানাইজারদের এক্সট্রা তথ্যের জন্য (Designation, Company Name ইত্যাদি)
  metaData Json? // 👈 এটি একটি ম্যাজিক ফিল্ড! এখানে যেকোনো কাস্টম অবজেক্ট রাখা যায়।

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
  seats    Seat[]

  @@index([email])
  @@index([status])
  @@map("users")
}
