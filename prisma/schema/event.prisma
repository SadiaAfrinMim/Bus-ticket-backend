model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  dateTime    DateTime
  venue       String
  price       Decimal   @db.Decimal(10, 2)
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  seats       Seat[]

  @@map("events")
}
