model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  dateTime    DateTime
  venue       String
  price       Decimal   @db.Decimal(10, 2) // নিখুঁত হিসাবের জন্য Decimal ব্যবহার করা হয়েছে
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  seats       Seat[]
  bookings    Booking[]

  @@map("events")
}