model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String
  role       Role       @default(USER)
  status     UserStatus @default(ACTIVE)
  profilePic String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  metaData   Json?
  bookings   Booking[]
  seats      Seat[]

  @@index([email])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}
